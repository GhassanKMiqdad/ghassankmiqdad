rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(projectId, userId) {
      return /databases/$(database)/documents/project_members/$(projectId + '_' + userId);
    }

    function hasPermission(projectId, key) {
      let path = memberPath(projectId, request.auth.uid);
      let membership = get(path).data;
      return signedIn()
        && exists(path)
        && membership.status == 'active'
        && (
          membership.role == 'owner'
          || (
            membership.permissions is list
            && 'project.view' in membership.permissions
            && key in membership.permissions
          )
      );
    }

    function teamMemberPath(teamId, userId) {
      return /databases/$(database)/documents/team_members/$(teamId + '_' + userId);
    }

    function isTeamMember(projectId, teamId, userId) {
      let membershipPath = teamMemberPath(teamId, userId);
      let membership = get(membershipPath).data;
      return signedIn()
        && exists(membershipPath)
        && membership.projectId == projectId
        && membership.teamId == teamId
        && membership.userId == userId
        && membership.status == 'active';
    }

    function activeTeam(projectId, teamId) {
      let path = /databases/$(database)/documents/teams/$(teamId);
      let team = get(path).data;
      return exists(path)
        && team.projectId == projectId
        && team.status == 'active';
    }

    function taskTeamVisible(data) {
      return !('team_id' in data) || data.team_id == null
        || hasPermission(data.project_id, 'project.edit')
        || isTeamMember(data.project_id, data.team_id, request.auth.uid);
    }

    function canSeeTask(data) {
      return taskTeamVisible(data)
        && (hasPermission(data.project_id, 'tasks.view')
          || (hasPermission(data.project_id, 'tasks.review') && data.status in ['review', 'submitted', 'under_review'])
          || (hasPermission(data.project_id, 'project.view') && data.assigned_to == request.auth.uid));
    }

    function canSeeDocument(data) {
      return hasPermission(data.project_id, 'project.view')
        && (!('team_id' in data) || data.team_id == null
          || hasPermission(data.project_id, 'project.edit')
          || isTeamMember(data.project_id, data.team_id, request.auth.uid))
        && (
          ('authorized_users' in data && data.authorized_users is list && request.auth.uid in data.authorized_users)
          || (hasPermission(data.project_id, 'documents.view')
            && (!('authorized_users' in data) || data.authorized_users == null
              || data.authorized_users.size() == 0 || hasPermission(data.project_id, 'project.edit')))
        );
    }

    function canReadWorkflowTask(projectId, taskId, researcherId) {
      let taskPath = /databases/$(database)/documents/tasks/$(taskId);
      return signedIn()
        && hasPermission(projectId, 'project.view')
        && exists(taskPath)
        && get(taskPath).data.project_id == projectId
        && taskTeamVisible(get(taskPath).data)
        && (researcherId == request.auth.uid
          || hasPermission(projectId, 'tasks.view')
          || hasPermission(projectId, 'tasks.review'));
    }

    function canReadTaskForWorkflow(projectId, taskId) {
      let taskPath = /databases/$(database)/documents/tasks/$(taskId);
      return signedIn()
        && hasPermission(projectId, 'project.view')
        && exists(taskPath)
        && get(taskPath).data.project_id == projectId
        && taskTeamVisible(get(taskPath).data)
        && (get(taskPath).data.assigned_to == request.auth.uid
          || hasPermission(projectId, 'tasks.view')
          || hasPermission(projectId, 'tasks.review'));
    }

    function canReadSubmission(data) {
      return canReadWorkflowTask(data.project_id, data.task_id, data.researcher_id);
    }

    function canReadReview(data) {
      let submissionPath = /databases/$(database)/documents/submissions/$(data.submission_id);
      return exists(submissionPath)
        && get(submissionPath).data.project_id == data.project_id
        && get(submissionPath).data.task_id == data.task_id
        && canReadSubmission(get(submissionPath).data);
    }

    function canReadDeliverable(data) {
      return canReadTaskForWorkflow(data.project_id, data.task_id);
    }

    // Public profile fields are never globally enumerable from client SDKs.
    // The server returns only the profiles needed by a user's authorized views.
    match /profiles/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /projects/{projectId} {
      allow get, list: if hasPermission(projectId, 'project.view');
      allow create, delete: if false;
      allow update: if hasPermission(projectId, 'project.edit')
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'description', 'research_goal', 'status', 'start_date', 'deadline', 'updated_at'])
        && request.resource.data.created_by == resource.data.created_by;
    }

    match /project_members/{memberId} {
      allow get, list: if signedIn()
        && (
          resource.data.user_id == request.auth.uid
          || hasPermission(resource.data.project_id, 'project.edit')
        );
      allow create, update, delete: if false;
    }

    match /user_permissions/{grantId} {
      allow get, list: if signedIn()
        && (
          resource.data.user_id == request.auth.uid
          || hasPermission(resource.data.project_id, 'project.edit')
        );
      allow write: if false;
    }

    match /teams/{teamId} {
      allow get, list: if hasPermission(resource.data.projectId, 'project.view')
        && (hasPermission(resource.data.projectId, 'project.edit')
          || (hasPermission(resource.data.projectId, 'team.view')
            && resource.data.memberIds is list
            && request.auth.uid in resource.data.memberIds));
      allow create, update, delete: if false;
    }

    match /team_members/{membershipId} {
      allow get, list: if signedIn()
        && (resource.data.userId == request.auth.uid
          || hasPermission(resource.data.projectId, 'project.edit'));
      allow create, update, delete: if false;
    }

    match /milestones/{milestoneId} {
      allow get, list: if hasPermission(resource.data.projectId, 'project.view')
        && (hasPermission(resource.data.projectId, 'project.edit')
          || (resource.data.researcherIds is list && request.auth.uid in resource.data.researcherIds)
          || (resource.data.teamId is string && isTeamMember(resource.data.projectId, resource.data.teamId, request.auth.uid)));
      allow create, update, delete: if false;
    }

    match /tasks/{taskId} {
      allow get, list: if canSeeTask(resource.data);
      // All task mutations go through authenticated Server Actions, which run
      // field-level policy checks and append server-side audit/activity records.
      allow create, update, delete: if false;
    }

    match /documents/{documentId} {
      allow get, list: if canSeeDocument(resource.data);
      allow create, update, delete: if false;
    }

    match /submissions/{submissionId} {
      allow get, list: if canReadSubmission(resource.data);
      allow create, update, delete: if false;
    }

    match /reviews/{reviewId} {
      allow get, list: if canReadReview(resource.data);
      allow create, update, delete: if false;
    }

    match /deliverables/{deliverableId} {
      allow get, list: if canReadDeliverable(resource.data);
      allow create, update, delete: if false;
    }

    match /comments/{commentId} {
      allow get, list: if signedIn() && (resource.data.author_id == request.auth.uid
        || (resource.data.task_id == null
          ? hasPermission(resource.data.project_id, 'team.view')
          : canSeeTask(get(/databases/$(database)/documents/tasks/$(resource.data.task_id)).data)));
      allow create, update, delete: if false;
    }

    match /activity_logs/{activityId} {
      allow get, list: if signedIn()
        && (
          resource.data.actor_id == request.auth.uid
          || (resource.data.project_id != null && hasPermission(resource.data.project_id, 'activity.view'))
        );
      allow create, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow get, list: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create, delete: if false;
      allow update: if signedIn()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read_at'])
        && (request.resource.data.read_at == null || request.resource.data.read_at is string);
    }

    // Catalogs are static, non-sensitive, and seeded from source-controlled definitions.
    match /permissions/{permissionId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /role_permissions/{templateId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
