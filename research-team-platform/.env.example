# =============================================================================
# Copy this file to `.env.local` for local development, and add the same
# variables in Vercel → Project → Settings → Environment Variables.
# Never commit real values.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — Dashboard → Project Settings → API (or "API Keys")
# -----------------------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
# Local Supabase CLI: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Public key: the legacy "anon" key or the new "sb_publishable_..." key.
# Safe in the browser — Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET key: the legacy "service_role" key or the new "sb_secret_..." key.
# Server-only (never add the NEXT_PUBLIC_ prefix). Used to invite members who
# do not have an account yet, to bootstrap platform admins and to clean up
# storage when a project is deleted.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Public URL of the deployed app; used to build links in auth e-mails.
# Production (Vercel): https://team-nesthire.vercel.app — also add it to Supabase Auth → URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated e-mails that are promoted to platform admin (system owner:
# may create projects and manage who else can) after a confirmed sign-in.
PLATFORM_ADMIN_EMAILS=

# IANA time zone used to decide whether a task is overdue (e.g. Asia/Gaza).
APP_TIMEZONE=UTC

# Default interface language: ar | en
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# Export endpoint protection. PostgreSQL enforces this atomically across instances.
EXPORT_RATE_LIMIT=5
EXPORT_RATE_WINDOW_SECONDS=60

# -----------------------------------------------------------------------------
# Local scripts only (npm run seed, npm run db:types) — not needed on Vercel
# -----------------------------------------------------------------------------
# Password given to the demo users created by `npm run seed`
# (a random one is generated and printed when empty).
SEED_USER_PASSWORD=
# Domain of the demo users' e-mail addresses.
SEED_EMAIL_DOMAIN=example.com
# Postgres connection string used by `npm run db:types`.
# Local Supabase CLI: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
