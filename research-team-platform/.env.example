# Copy to .env.local for local development. Never commit real credentials.

# Firebase Web API key (public project identifier, not an Admin credential).
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyC8MEANlVWWKpu2dWX6c778glVO1eYYTaE
FIREBASE_PROJECT_ID=research-team-platform
FIREBASE_STORAGE_BUCKET=research-team-platform.firebasestorage.app
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=research-team-platform.firebaseapp.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=295939978439
NEXT_PUBLIC_FIREBASE_APP_ID=1:295939978439:web:43ba9b5226a1741ccf3ae2
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-JY7SJSE810
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase Admin SDK credentials. Use either a service-account JSON value or
# FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY; on Google Cloud, use ADC instead.
# Keep all private values server-side. Emulators require no production secrets.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional Firebase Auth emulator host (for local runs: 127.0.0.1:9099).
FIREBASE_AUTH_EMULATOR_HOST=
# FIRESTORE_EMULATOR_HOST / FIREBASE_STORAGE_EMULATOR_HOST are set by Firebase CLI.

PLATFORM_ADMIN_EMAILS=
APP_TIMEZONE=UTC
NEXT_PUBLIC_DEFAULT_LOCALE=ar
